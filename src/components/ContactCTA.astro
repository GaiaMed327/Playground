---
// ContactCTA.astro - Sección de cierre / Contacto
import { Image } from 'astro:assets';
import patoLogo from '../assets/INICIO/PATO_LOGO.png';
---
<section class="py-16 bg-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    
    <div class="md:col-span-6 flex flex-col items-center md:items-start text-center md:text-left space-y-4 relative">
      
      <div class="w-24 sm:w-32 animate-bounce select-none mb-4" style="animation-duration: 3s;">
        <Image src={patoLogo} alt="Logo Pato" class="w-full h-auto" />
      </div>

      <h3 class="font-display text-2xl sm:text-3xl text-sky-400 font-bold">
        ¿Tienes una idea en mente? <br/>
        <span class="text-gray-800">diseñemos algo increíble juntos.</span>
      </h3>
      
      <p class="font-display text-4xl text-gray-900 font-extrabold tracking-tight">
        ¡Hablemos!
      </p>

      <div class="text-2xl select-none absolute bottom-0 right-10 opacity-30">✨</div>
    </div>

    <div class="md:col-span-6 flex flex-col sm:flex-row justify-center md:justify-end gap-12 text-center sm:text-left">
      
      <div class="space-y-2">
        <h4 class="font-display text-2xl text-gray-900 font-bold">Correo</h4>
        <p class="font-sans text-gray-600 text-sm sm:text-base">[Correo Electronico de Vale ✉️]</p>
      </div>

      <div class="space-y-2 flex flex-col items-center sm:items-start">
        <h4 class="font-display text-2xl text-gray-900 font-bold">Instagram</h4>
        <div class="w-24 h-24 bg-gray-100 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center text-[10px] text-gray-400 text-center p-2">
          [Falta Código QR de IG 📱]
        </div>
      </div>

    </div>

  </div>

  <div class="w-full text-center py-6 border-t border-gray-100 mt-12 font-display text-xs text-gray-500">
    © Playground STUDIO
  </div>
</section>