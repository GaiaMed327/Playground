---
import { Image } from 'astro:assets';
import estrellaAzul from '../assets/INICIO/estrella_azul.png';
import estrellaVerde from '../assets/INICIO/estrella_verde.png';
import estrellaAmarilla from '../assets/INICIO/estrella_amarilla.png';
import estrellaRosa from '../assets/INICIO/estrella_rosa.png';

const { class: className } = Astro.props;
---
<div class={`flex items-end gap-0.5 select-none pointer-events-none absolute ${className}`}>
  <Image src={estrellaAzul} alt="" class="w-8 sm:w-10 h-auto animate-pulse transform -rotate-12" style="animation-duration: 2s;" />
  <Image src={estrellaVerde} alt="" class="w-6 sm:w-7 h-auto animate-bounce transform rotate-15 -translate-y-1" style="animation-duration: 2.5s;" />
  <Image src={estrellaAmarilla} alt="" class="w-5 sm:w-6 h-auto animate-pulse transform -rotate-6 -translate-y-2" style="animation-duration: 1.8s;" />
  <Image src={estrellaRosa} alt="" class="w-4 sm:w-4 h-auto animate-bounce transform rotate-[45deg] -translate-y-1" style="animation-duration: 3.2s;" />
</div>