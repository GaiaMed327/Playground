---
// FeaturedPortfolio.astro - Portafolio Destacado de Vale
---
<section class="py-20 bg-white relative overflow-hidden">
  <div class="absolute top-12 left-6 text-2xl opacity-40 select-none">⭐</div>
  <div class="absolute bottom-16 right-6 text-2xl opacity-40 select-none">⭐</div>

  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl text-gray-900 tracking-tight">
        Portafolio destacado
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      
      <div class="bg-amber-100 rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer aspect-[3/4] flex items-center justify-center border-4 border-white">
        <span class="font-display text-gray-500 font-bold">Crayola 🖍️</span>
      </div>

      <div class="bg-green-100 rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer aspect-[3/4] flex items-center justify-center border-4 border-white">
        <span class="font-display text-gray-500 font-bold">Big Adventures 🐼</span>
      </div>

      <div class="bg-sky-100 rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer aspect-[3/4] flex items-center justify-center border-4 border-white">
        <span class="font-display text-gray-500 font-bold">Sylvanian Families 🐰</span>
      </div>

      <div class="bg-purple-100 rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer aspect-[3/4] flex items-center justify-center border-4 border-white">
        <span class="font-display text-gray-500 font-bold">Fotografía/Diseño ⚽</span>
      </div>

      <div class="bg-rose-100 rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer aspect-[3/4] flex items-center justify-center border-4 border-white">
        <span class="font-display text-gray-500 font-bold">Cards Procrear 🃏</span>
      </div>

    </div>

    <div class="text-center mt-12">
      <a 
        href="/portafolio" 
        class="inline-block px-8 py-3 bg-[#EF4444] text-white text-lg font-bold rounded-full shadow-[0_4px_0_#B91C1C] hover:shadow-[0_1px_0_#B91C1C] hover:translate-y-[3px] transition-all font-display"
      >
        Ver mis proyectos
      </a>
    </div>

  </div>
</section>