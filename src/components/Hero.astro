---
// Componente Hero para Playground STUDIO
import { Image } from 'astro:assets';
import patitoImg from '../assets/INICIO/pato_de_cabeza.png';
import fondoBanner from '../assets/INICIO/fondo_banner.png';

import juegos from '../assets/INICIO/JUEGOS DE PARQUE/juegos_completos.png';

import estrellaAzul from '../assets/INICIO/estrella_azul.png';
import estrellaVerde from '../assets/INICIO/estrella_verde.png';
import estrellaAmarilla from '../assets/INICIO/estrella_amarilla.png';
import estrellaRosa from '../assets/INICIO/estrella_rosa.png';
---

<section 
  class="relative w-full min-h-[85vh] flex items-center overflow-hidden py-12 md:py-0 bg-cover bg-center bg-no-repeat"
  style={`background-image: url(${fondoBanner.src});`}
>
  
  <div class="absolute inset-0 w-full h-full opacity-90 pointer-events-none z-0">
    <Image 
      src={juegos} 
      alt="Juegos de parque de fondo" 
      class="w-full h-full object-cover object-center md:object-bottom" 
    />
  </div>

  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10">
    
    <div class="md:col-span-7 text-center md:text-left flex flex-col items-center md:items-start relative">
      
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-gray-900 leading-tight tracking-tight max-w-xl relative">
  
        <span class="relative inline-block mr-2 z-10">
          Transformamos
          
          <Image 
            src={estrellaAzul} 
            alt="Estrella Azul" 
            class="absolute -top-7 -left-6 w-10 sm:w-12 h-auto animate-pulse select-none" 
            style="animation-duration: 2s;"
          />
          
          <Image 
            src={estrellaVerde} 
            alt="Estrella Verde" 
            class="absolute -top-9 left-[40%] w-7 sm:w-9 h-auto animate-bounce select-none" 
            style="animation-duration: 2.5s;"
          />
          
          <Image 
            src={estrellaAmarilla} 
            alt="Estrella Amarilla" 
            class="absolute -top-4 right-2 w-5 sm:w-7 h-auto animate-pulse select-none" 
            style="animation-duration: 1.8s;"
          />
          
          <Image 
            src={estrellaRosa} 
            alt="Estrella Rosa" 
            class="absolute top-5 -right-4 w-4 sm:w-5 h-auto animate-bounce select-none" 
            style="animation-duration: 3.2s;"
          />
        </span>ideas en <span class="text-[#3B82F6] underline decoration-wavy decoration-[#F59E0B] mx-1">juegos</span> <span class="text-[#EF4444]">visuales</span>
      </h1>
      
      <div class="mt-6 font-sans text-lg sm:text-xl text-gray-700 space-y-4 max-w-lg font-medium">
        <p>
          Branding, ilustración, fotografía y proyectos con propósito.
        </p>
        <p>
          Convertimos ideas en 
          <span class="text-[#F59E0B] font-bold">experiencias creativas</span> 
          que 
          <span class="text-[#10B981] font-bold">conectan</span>.
        </p>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto font-display">
        <a 
          href="/portafolio" 
          class="px-8 py-4 bg-[#F59E0B] text-white text-xl font-bold rounded-full shadow-[0_5px_0_#D97706] hover:shadow-[0_2px_0_#D97706] hover:translate-y-[3px] transition-all text-center group"
        >
          Ver portafolio 
          <span class="inline-block transition-transform group-hover:translate-x-1">🚀</span>
        </a>

        <a 
          href="/sobre-mi" 
          class="px-8 py-4 bg-[#FEF08A] text-gray-800 text-xl font-bold rounded-full border-2 border-[#F59E0B] shadow-[0_5px_0_#F59E0B] hover:shadow-[0_2px_0_#F59E0B] hover:translate-y-[3px] transition-all text-center"
        >
          Sobre Playground
        </a>
      </div>

    </div>

    <div class="md:col-span-5 flex justify-center items-center relative min-h-[320px] sm:min-h-[420px] md:min-h-full">
      
      <div class="w-64 h-64 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px] bg-[#FEF08A] rounded-full border-8 border-white shadow-lg relative overflow-hidden z-10 flex items-center justify-center">
        
        <Image 
          src={patitoImg} 
          alt="Un patito simpático integrado en el círculo" 
          loading="eager"
          class="w-full h-full object-cover object-center transform scale-100 hover:scale-110 hover:rotate-3 transition-transform duration-300 select-none cursor-pointer" 
        />

      </div>

    </div>

  </div>

  <div class="absolute bottom-0 left-0 w-full h-12 bg-[#10B981]/20 border-t-4 border-[#10B981]/10"></div>
</section>